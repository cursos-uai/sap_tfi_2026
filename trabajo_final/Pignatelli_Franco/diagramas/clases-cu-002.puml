' Diagrama de clases CU-002 (planificación de navegación con IA): pedido, ranking, plan y confirmación
' Fuente de verdad: backend/app (clases, firmas y relaciones comprobadas por lint_evidencia.py sobre clases.json).
package "Controllers y Policies" {
  together {
    class "NavigationPlansController" as Api__V1__NavigationPlansController <<controller>> {
      + create(): void
      + show(): void
    }
    class "NavigationPlanPolicy" as NavigationPlanPolicy <<policy>> {
      + index?(): Boolean
      + create?(): Boolean
      + show?(): Boolean
    }
  }
  together {
    class "RouteSuggestionsController" as Api__V1__RouteSuggestionsController <<controller>> {
      + confirm(): void
    }
    class "RouteSuggestionPolicy" as RouteSuggestionPolicy <<policy>> {
      + show?(): Boolean
      + confirm?(): Boolean
    }
  }
}
package "Services" {
  class "Navigation::RequestValidator" as Navigation__RequestValidator <<service>> {
    + initialize(params: Hash)
    + errors(): Array<String>
  }
  class "Navigation::IaProcessor" as Navigation__IaProcessor <<service>> {
    + initialize(data: Hash)
    + process(): Hash
    - parse_response(text: String, raw: Hash): Hash
    - fallback(): Hash
  }
  class "Navigation::DataCollector" as Navigation__DataCollector <<service>> {
    + initialize(user: User, params: Hash,
    {method}       waypoint_scope: Relation)
    + collect(): Hash
  }
  class "Navigation::PlanBuilder" as Navigation__PlanBuilder <<service>> {
    + initialize(user: User, data: Hash, ranking: Hash)
    + build(): NavigationPlan
  }
  class "Navigation::LegNormalizer" as Navigation__LegNormalizer <<service>> {
    + initialize(raw_legs: Array<Hash>,
    {method}       waypoint_scope: Relation)
    + call(): Array<Hash>
  }
  class "IaService" as IaService <<service>> {
    + initialize(timeout: Integer = 25)
    + generate(prompt: String, response_schema: Hash = nil,
    {method}       inline_data: Hash = nil, temperature: Float = 0.2,
    {method}       max_output_tokens: Integer = 1024): Hash
  }
  class "Navigation::Ranker" as Navigation__Ranker <<service>> {
    + initialize(data: Hash)
    + call(): Hash
  }
  class "Observers::MonitoringTrigger" as Observers__MonitoringTrigger <<service>> {
    {static} + update(event: Symbol, subject: Object,
    {method}       data: Hash = {}): void
  }
}
package "Models" {
  class "Aircraft" as Aircraft <<model>> {
    - registration: String
    - status: String
    - engine_hours: BigDecimal
    - fuel_capacity: BigDecimal
    --
    {static} + active(): Relation
    + to_s(): String
  }
  class "NavigationPlan" as NavigationPlan <<model>> {
    - origin_code: String
    - destination_hint_code: String
    - autonomy_hours: BigDecimal
    - scheduled_at: Time
    - status: String
    - ia_available: Boolean
  }
  class "RouteSuggestion" as RouteSuggestion <<model>> {
    - aerodrome_code: String
    - rank: Integer
    - viable: Boolean
    - distance_km: BigDecimal
    --
    + confirmed?(): Boolean
    {static} + ranked(): Relation
  }
  class "Reservation" as Reservation <<model>> {
    - origin_code: String
    - destination_code: String
    - scheduled_at: Time
    - status: String
    --
    + latest_evaluation(): PreFlightEvaluation
    + cancel!(): Boolean
    + complete!(): Boolean
    - emit_reservation_created(): void
  }
  class "Observable" as Observable <<model>> <<module>> {
    {static} + add_observer(observer: Class): void
    + notify_observers(event: Symbol, data: Hash = {}): void
  }
}
